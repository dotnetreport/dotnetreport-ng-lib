{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "angularCompilerOptions": {
    "enableIvy": true,
    "compilationMode": "partial"
  },
  "exclude": [
    "src/test.ts",
    "**/*.spec.ts"
  ]
}
