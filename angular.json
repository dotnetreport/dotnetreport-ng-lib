{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dotnetreport-lib": {
      "projectType": "library",
      "root": "projects/dotnetreport-lib",
      "sourceRoot": "projects/dotnetreport-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dotnetreport-lib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dotnetreport-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dotnetreport-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/dotnetreport-lib/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "dotnetreport-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/dotnetreport-app",
      "sourceRoot": "projects/dotnetreport-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/dotnetreport-app",
            "index": "projects/dotnetreport-app/src/index.html",
            "browser": "projects/dotnetreport-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/dotnetreport-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/dotnetreport-app/public"
              }
            ],
            "styles": [
              "projects/dotnetreport-app/src/styles.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/select2/dist/css/select2.min.css",
              "node_modules/dotnetreport/src/dotnetreport.css",
              "node_modules/gridstack/dist/gridstack.min.css",
              "node_modules/tributejs/dist/tribute.css",
              "node_modules/summernote/dist/summernote-bs5.min.css",
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/x-editable-bs4/dist/bootstrap4-editable/css/bootstrap-editable.css"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
              "node_modules/summernote/dist/summernote-bs5.min.js",
              "node_modules/leaflet/dist/leaflet.js",
              "node_modules/leaflet.heat/dist/leaflet-heat.js",
              "node_modules/knockout/build/output/knockout-latest.js",
              "node_modules/jquery-blockui/jquery.blockUI.js",
              "node_modules/bootbox/dist/bootbox.min.js",
              "node_modules/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js",
              "node_modules/jquery-ui-dist/jquery-ui.min.js",
              "node_modules/knockout-sortable/build/knockout-sortable.min.js",
              "node_modules/select2/dist/js/select2.min.js",
              "node_modules/lodash/lodash.min.js",
              "node_modules/tributejs/dist/tribute.min.js",
              "node_modules/knockout-mapping/dist/knockout.mapping.js",
              "node_modules/x-editable-bs4/dist/bootstrap4-editable/js/bootstrap-editable.min.js",
              "node_modules/knockout-x-editable/knockout.x-editable.min.js",
              "node_modules/dotnetreport/src/dotnetreport.js",
              "node_modules/dotnetreport/src/dotnetreport-helper.js",
              "node_modules/dotnetreport/src/dotnetreport-setup.js",
              "node_modules/gridstack/dist/gridstack-all.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dotnetreport-app:build:production"
            },
            "development": {
              "buildTarget": "dotnetreport-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/dotnetreport-app/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/dotnetreport-app/public"
              }
            ],
            "styles": [
              "projects/dotnetreport-app/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
